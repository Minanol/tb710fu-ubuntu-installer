[Unit]
Description=TB710FU single-system installer (development only)
ConditionKernelCommandLine=tb710fu.install=single
DefaultDependencies=no
After=systemd-udevd.service systemd-remount-fs.service
Before=sysinit.target display-manager.service
Conflicts=shutdown.target

[Service]
Type=oneshot
Environment=TB710FU_ENABLE_UNTESTED_INSTALLER=yes
ExecStart=/usr/local/sbin/tb-install-single
TimeoutStartSec=0
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty0
TTYReset=yes
TTYVHangup=no
TTYVTDisallocate=no

[Install]
WantedBy=sysinit.target
