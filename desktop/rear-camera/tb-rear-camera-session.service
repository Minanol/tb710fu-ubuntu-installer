[Unit]
Description=Recover TB710FU rear-camera enumeration after login
After=graphical-session-pre.target wireplumber.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/tb-rear-camera-session.py
TimeoutStartSec=70

[Install]
WantedBy=graphical-session.target
