[Unit]
Description=TB710FU lock screen physical backlight control
After=graphical-session-pre.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/tb-backlight-power --watch
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
